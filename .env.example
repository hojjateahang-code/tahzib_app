# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# For Mobile / Capacitor APK builds:
# Set this to your deployed online server domain (e.g. https://tahzib.your-domain.ir)
# so the Android app knows where to reach the backend APIs.
VITE_API_BASE_URL=""

# Local Disk Storage Directory Path inside container (Mapped to /home/mfih/tahzib_storage on host server)
# Volume persistence for backups, attachments, and update files.
STORAGE_PATH=/app/storage

# (Optional) MinIO / S3 Cloud Sync Credentials (Leave empty if using local disk storage only)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_BUCKET=
MINIO_PREFIX=

# Backend Firebase Admin base 64 encoded serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
